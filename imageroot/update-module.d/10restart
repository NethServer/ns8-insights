#
# The collector reads its code and environment once at startup: restart
# it after an update, or the old version keeps running. A disabled
# collector stays stopped.
#

import os

import insights

if os.getenv('INSIGHTS_ENABLED', '0') == '1':
    insights.systemctl('daemon-reload')
    insights.start_collector()
