#
# Read the findings of this cluster from the insights server. The call
# runs here, not in the browser, so the subscription secret never leaves
# the cluster.
#

import base64
import json
import os
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request

import agent
import insights

TIMEOUT_SECONDS = 30

# api-cli sends null when called without --data
request = json.load(sys.stdin) or {}
status = request.get('status', 'open')


def fail(error, detail=''):
    """Report a known failure the UI can translate, and stop.

    The request itself was valid: the action succeeds with an error code
    instead of failing, so the UI shows it in place of the table.
    """
    print(agent.SD_WARNING + f"list-findings: {error} {detail}".strip(), file=sys.stderr)
    json.dump({'findings': [], 'error': error}, fp=sys.stdout)
    sys.exit(0)


rdb = agent.redis_connect(use_replica=True)
system_id, auth_token = insights.get_subscription(rdb)
if not system_id:
    fail('subscription_required')

base_url = os.getenv('INSIGHTS_SERVER_URL', insights.DEFAULT_SERVER_URL).rstrip('/')
url = base_url + '/logs/v1/findings'
if status != 'all':
    url += '?' + urllib.parse.urlencode({'status': status})

credentials = base64.b64encode(f"{system_id}:{auth_token}".encode()).decode()
http_request = urllib.request.Request(url, headers={
    'Authorization': 'Basic ' + credentials,
    'Accept': 'application/json',
})

context = None
if os.getenv('INSIGHTS_VERIFY_TLS', '1') == '0':
    context = ssl._create_unverified_context()

try:
    with urllib.request.urlopen(http_request, timeout=TIMEOUT_SECONDS, context=context) as response:
        body = json.load(response)
except urllib.error.HTTPError as ex:
    if ex.code in (401, 403):
        fail('server_unauthorized', str(ex.code))
    fail('server_error', f"{ex.code} {ex.read().decode('utf-8', 'replace')[:300]}")
except urllib.error.URLError as ex:
    if isinstance(ex.reason, ssl.SSLError):
        fail('server_tls_error', str(ex.reason))
    fail('server_unreachable', str(ex.reason))
except (TimeoutError, OSError) as ex:
    fail('server_unreachable', str(ex))
except ValueError as ex:
    fail('server_error', f"invalid JSON: {ex}")

json.dump({'findings': body.get('findings') or [], 'error': ''}, fp=sys.stdout)
