{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "list-findings input",
    "$id": "http://schema.nethserver.org/insights/list-findings-input.json",
    "description": "List the findings of this cluster from the insights server",
    "examples": [
        {
            "status": "open"
        }
    ],
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "status": {
            "type": "string",
            "enum": ["open", "stale", "all"],
            "default": "open",
            "description": "Which findings to return. Default open"
        }
    }
}
