{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "list-findings output",
    "$id": "http://schema.nethserver.org/insights/list-findings-output.json",
    "description": "Findings of this cluster, sorted by severity, then by last seen, newest first",
    "examples": [
        {
            "findings": [
                {
                    "id": "01J8Z1K2M3N4P5Q6R7S8T9V0W1",
                    "system_id": "abc123",
                    "fingerprint": "9f2b7e1c4a",
                    "severity": "high",
                    "title": "Repeated connection refused on traefik1",
                    "summary": "traefik1 logged 37 connection-refused events in 15 minutes, far above baseline.",
                    "suggested_action": "Check whether the upstream service on traefik1 is down or overloaded.",
                    "modules": ["traefik1"],
                    "evidence": ["<3> [n1:traefik1:traefik] connection refused to 10.0.0.4:8080"],
                    "status": "open",
                    "occurrence_count": 1,
                    "first_seen": 1754380811000,
                    "last_seen": 1754381690000,
                    "llm_model": "model",
                    "prompt_version": "v1",
                    "node_refs": [{"node_id": 1, "fqdn": "node1.example.com"}],
                    "security": false
                }
            ],
            "error": ""
        }
    ],
    "type": "object",
    "required": ["findings", "error"],
    "properties": {
        "error": {
            "type": "string",
            "enum": ["", "subscription_required", "server_unauthorized", "server_unreachable", "server_tls_error", "server_error"],
            "description": "Why the findings could not be read, empty on success"
        },
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "severity", "title", "summary", "suggested_action", "modules", "status", "last_seen"],
                "properties": {
                    "id": {"type": "string"},
                    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
                    "title": {"type": "string"},
                    "summary": {"type": "string"},
                    "suggested_action": {"type": "string"},
                    "modules": {"type": "array", "items": {"type": "string"}},
                    "evidence": {"type": "array", "items": {"type": "string"}},
                    "status": {"type": "string", "enum": ["open", "stale"]},
                    "occurrence_count": {"type": "integer"},
                    "first_seen": {"type": "integer", "description": "Unix time in milliseconds"},
                    "last_seen": {"type": "integer", "description": "Unix time in milliseconds"},
                    "reopened_at": {"type": "integer", "description": "Unix time in milliseconds"},
                    "nodes": {"type": "array", "items": {"type": "integer"}},
                    "node_refs": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "node_id": {"type": "integer"},
                                "fqdn": {"type": "string"}
                            }
                        }
                    },
                    "doc_ref": {"type": "string"},
                    "security": {"type": "boolean"}
                }
            }
        }
    }
}
