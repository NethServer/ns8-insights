import json
import sys

import agent
import insights

request = json.load(sys.stdin)

enabled = request['enabled']
base_url = request.get('base_url') or insights.DEFAULT_SERVER_URL
verify_tls = request.get('verify_tls', True)

if enabled:
    rdb = agent.redis_connect(use_replica=True)
    errors = []
    # The server accepts data only from subscribed machines.
    if insights.get_subscription(rdb) == (None, None):
        errors.append({'field': 'enabled', 'parameter': 'enabled',
                       'value': enabled, 'error': 'subscription_required'})
    else:
        active_elsewhere = insights.find_active_elsewhere(rdb)
        if active_elsewhere:
            errors.append({'field': 'enabled', 'parameter': 'enabled',
                           'value': active_elsewhere, 'error': 'active_elsewhere'})
    if errors:
        agent.set_status('validation-failed')
        json.dump(errors, fp=sys.stdout)
        sys.exit(3)

agent.set_env('INSIGHTS_SERVER_URL', base_url.rstrip('/'))
agent.set_env('INSIGHTS_VERIFY_TLS', '1' if verify_tls else '0')
agent.set_env('INSIGHTS_ENABLED', '1' if enabled else '0')

if enabled:
    insights.start_collector()
else:
    insights.stop_collector()
